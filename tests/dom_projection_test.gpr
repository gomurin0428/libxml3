project DOM_Projection_Test is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("../src", ".");
   for Source_Files use
     ("xml3_text.ads", "xml3_text.adb",
      "xml3_native_memory.ads", "xml3_native_memory.adb",
      "dom_projection_test.adb", "dom_projection_probe.c");
   for Main use ("dom_projection_test.adb");
   for Object_Dir use "../obj/dom-projection-test";
   for Exec_Dir use ".";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-Werror",
         "-I" & DOM_Projection_Test'Project_Dir & "../include");
   end Compiler;
end DOM_Projection_Test;
