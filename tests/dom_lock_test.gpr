project DOM_Lock_Test is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("../src", ".");
   for Source_Files use
     ("xml3_dom_lock.ads", "xml3_dom_lock.adb",
      "dom_lock_test.adb", "dom_lock_test_mutex.c");
   for Main use ("dom_lock_test.adb");
   for Object_Dir use "../obj/dom-lock-test";
   for Exec_Dir use ".";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-Werror");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-Werror");
   end Compiler;
end DOM_Lock_Test;
