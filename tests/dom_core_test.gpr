project DOM_Core_Test is
   for Source_Dirs use ("../src", ".");
   for Source_Files use
      ("xml3_dom.ads", "xml3_dom.adb",
       "xml3_dom_allocation.ads", "xml3_dom_allocation.adb",
       "dom_core_test.adb");
   for Main use ("dom_core_test.adb");
   for Object_Dir use "../obj/dom-core-test";
   for Exec_Dir use ".";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end DOM_Core_Test;
