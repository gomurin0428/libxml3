project Encoding_Test is
   for Source_Dirs use ("../src", ".");
   for Source_Files use
      ("xml3_text.ads", "xml3_text.adb",
      "xml3_encoding.ads", "xml3_encoding.adb",
      "encoding_test.adb");
   for Main use ("encoding_test.adb");
   for Object_Dir use "../obj/encoding-test";
   for Exec_Dir use ".";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end Encoding_Test;
