project DOM_Bridge_Test is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("../src", ".");
   for Source_Files use
     ("xml3_dom.ads", "xml3_dom.adb",
      "xml3_dom_allocation.ads", "xml3_dom_allocation.adb",
      "xml3_native_memory.ads", "xml3_native_memory.adb",
      "xml3_dom_bridge.ads", "xml3_dom_bridge.adb",
      "dom_bridge_test.adb", "dom_bridge_facade.c");
   for Main use ("dom_bridge_test.adb");
   for Object_Dir use "../obj/dom-bridge-test";
   for Exec_Dir use ".";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-Werror",
         "-I" & DOM_Bridge_Test'Project_Dir & "../include");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-Wl,--wrap=free");
   end Linker;
end DOM_Bridge_Test;
