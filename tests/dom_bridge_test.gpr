project DOM_Bridge_Test is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("../src", ".");
   for Source_Files use
     ("xml3_dom.ads", "xml3_dom.adb",
      "xml3_dom_constructors.ads", "xml3_dom_constructors.adb",
      "xml3_dom_store.ads", "xml3_dom_store.adb",
      "xml3_dom_store-queries.ads", "xml3_dom_store-queries.adb",
      "xml3_dom_store-properties.ads", "xml3_dom_store-properties.adb",
      "xml3_dom_store-documents.ads", "xml3_dom_store-documents.adb",
      "xml3_dom-materialize.ads", "xml3_dom-materialize.adb",
      "xml3_dom-import.ads", "xml3_dom-import.adb",
      "xml3_dom_allocation.ads", "xml3_dom_allocation.adb",
      "xml3_namespaces.ads", "xml3_namespaces.adb",
      "xml3_diagnostic_messages.ads",
      "xml3_error_records.ads", "xml3_error_records.adb",
      "xml3_text.ads", "xml3_text.adb",
      "xml3_text-buffers.ads", "xml3_text-buffers.adb",
      "xml3_parser.ads", "xml3_parser.adb",
      "xml3_parser-native_sizes.ads",
      "xml3_parser-options.ads", "xml3_parser-options.adb",
      "xml3_parser-workspaces.ads", "xml3_parser-workspaces.adb",
      "xml3_encoding.ads", "xml3_encoding.adb",
      "xml3_native_memory.ads", "xml3_native_memory.adb",
      "xml3_dom_bridge.ads", "xml3_dom_bridge.adb",
      "dom_bridge_test.adb", "dom_bridge_facade.c");
   for Main use ("dom_bridge_test.adb");
   for Object_Dir use "../obj/dom-bridge-test";
   for Exec_Dir use ".";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-Werror",
         "-I" & DOM_Bridge_Test'Project_Dir & "../include");
   end Compiler;
   package Binder is
      --  Keep assertion scratch allocations outside malloc fault injection.
      for Default_Switches ("Ada") use ("-D16m");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-Wl,--wrap=free", "-Wl,--wrap=malloc");
   end Linker;
end DOM_Bridge_Test;
