library project Libxml3 is
   type Build_Profile is ("production", "development");
   Profile : Build_Profile := external ("LIBXML3_PROFILE", "production");
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src");
   for Object_Dir use "obj/libxml3/" & Profile;
   case Profile is
      when "production" =>
         for Library_Dir use "lib";
      when "development" =>
         for Library_Dir use "lib/development";
   end case;
   for Library_Name use "xml3";
   for Library_Kind use "dynamic";
   for Library_Interface use ("xml3_c", "xml3_errors");
   for Library_Standalone use "encapsulated";
   for Library_Auto_Init use "true";
   for Library_Options use ("-pthread");
   package Compiler is
      case Profile is
         when "production" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-gnatwa", "-gnato", "-O2");
         when "development" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-gnatwa", "-gnata", "-gnato", "-g");
      end case;
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-pthread",
         "-I" & Libxml3'Project_Dir & "/include");
   end Compiler;
end Libxml3;
