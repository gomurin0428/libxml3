project Proof is
   for Source_Dirs use ("src");
   for Source_Files use ("xml3_text.ads", "xml3_text.adb", "xml3_parser.ads", "xml3_parser.adb",
                        "xml3_diagnostic_messages.ads",
                        "xml3_diagnostic_codes.ads",
                        "xml3_error_records.ads", "xml3_error_records.adb",
                        "xml3_parser-native_sizes.ads",
                        "xml3_parser-attempts.ads", "xml3_parser-attempts.adb",
                        "xml3_parser-options.ads", "xml3_parser-options.adb",
                        "xml3_parser-outcomes.ads",
                        "xml3_parser-requests.ads",
                        "xml3_parser-statuses.ads",
                        "xml3_dom_results.ads",
                        "xml3_text_results.ads",
                        "xml3_entry_guards.ads",
                        "xml3_parser-workspaces.ads", "xml3_parser-workspaces.adb",
                        "xml3_text-qnames.ads", "xml3_text-qnames.adb",
                        "xml3_text-buffers.ads", "xml3_text-buffers.adb",
                        "xml3_namespaces.ads", "xml3_namespaces.adb",
                        "xml3_encoding.ads", "xml3_encoding.adb",
                        "xml3_encoding-buffers.ads", "xml3_encoding-buffers.adb",
                        "xml3_dom.ads", "xml3_dom.adb",
                        "xml3_dom-graph_lemmas.ads", "xml3_dom-graph_lemmas.adb",
                        "xml3_dom-links.ads", "xml3_dom-links.adb",
                        "xml3_dom-projection.ads", "xml3_dom-projection.adb",
                        "xml3_dom-marking.ads", "xml3_dom-marking.adb",
                        "xml3_dom-freeing.ads", "xml3_dom-freeing.adb",
                        "xml3_dom-releases.ads", "xml3_dom-releases.adb",
                        "xml3_dom-retirement.ads", "xml3_dom-retirement.adb",
                        "xml3_dom_constructors.ads", "xml3_dom_constructors.adb",
                        "xml3_dom_store.ads", "xml3_dom_store.adb",
                        "xml3_dom_store-queries.ads", "xml3_dom_store-queries.adb",
                        "xml3_dom_store-properties.ads", "xml3_dom_store-properties.adb",
                        "xml3_dom_store-documents.ads", "xml3_dom_store-documents.adb",
                        "xml3_dom_store-content.ads", "xml3_dom_store-content.adb",
                        "xml3_dom_store-copies.ads", "xml3_dom_store-copies.adb",
                        "xml3_dom_store-serialization.ads", "xml3_dom_store-serialization.adb",
                        "xml3_serialization.ads", "xml3_serialization.adb",
                        "xml3_dom_runtime.ads", "xml3_dom_runtime.adb",
                        "xml3_dom-materialize.ads", "xml3_dom-materialize.adb",
                        "xml3_dom-import.ads", "xml3_dom-import.adb",
                        "xml3_dom_bridge.ads", "xml3_dom_bridge.adb",
                        "xml3_native_memory.ads",
                        "xml3_dom_allocation.ads");
   for Object_Dir use "obj/proof";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=all", "--checks-as-errors=on");
   end Prove;
end Proof;
